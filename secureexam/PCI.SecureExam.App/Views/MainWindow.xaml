<Window x:Class="PCI.SecureExam.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PCI Secure Exam" Height="820" Width="1280"
        WindowStartupLocation="CenterScreen" Background="#0B1322"
        FontFamily="Segoe UI" UseLayoutRounding="True">
  <Window.Resources>
    <Style TargetType="Button" BasedOn="{StaticResource Btn}"/>
    <Style x:Key="Ghost" TargetType="Button">
      <Setter Property="Background" Value="#16213A"/>
      <Setter Property="Foreground" Value="#C7D2E4"/>
      <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="14"/>
      <Setter Property="Padding" Value="16,10"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <!-- top brand + status bar -->
    <Grid VerticalAlignment="Top" Height="60" Background="#0E1626" Panel.ZIndex="5">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" Margin="22,0" VerticalAlignment="Center">
        <Border Background="#1D4ED8" CornerRadius="8" Width="34" Height="34" Margin="0,0,10,0">
          <TextBlock Text="PCI" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock Text="Secure Exam" Foreground="#E7EEFB" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
      </StackPanel>
      <TextBlock x:Name="ScreenLabel" Grid.Column="1" Text="System check" Foreground="#8AA1CC" FontSize="12"
                 FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="22,0" VerticalAlignment="Center">
        <Border x:Name="ConnPill" Background="#123021" CornerRadius="14" Padding="10,5" Margin="0,0,10,0">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="7" Height="7" Fill="#4ADE80" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBlock x:Name="ConnText" Text="Online" Foreground="#7DEBA5" FontSize="11.5" FontWeight="SemiBold"/>
          </StackPanel>
        </Border>
        <Border x:Name="TimerPill" Background="#152449" CornerRadius="10" Padding="12,6" Visibility="Collapsed">
          <TextBlock x:Name="TimerText" Text="90:00" Foreground="#9FC0FF" FontFamily="Consolas" FontWeight="Bold" FontSize="15"/>
        </Border>
      </StackPanel>
    </Grid>

    <!-- swappable screen host -->
    <ContentControl x:Name="Host" Margin="0,60,0,0"/>

    <!-- violation toast -->
    <Border x:Name="Toast" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,72,0,0"
            Background="#2A1512" CornerRadius="12" Padding="16,11" Visibility="Collapsed" Panel.ZIndex="20">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="&#9888;" Foreground="#FCA5A5" FontSize="15" Margin="0,0,9,0"/>
        <TextBlock x:Name="ToastText" Foreground="#FCA5A5" FontSize="13" FontWeight="SemiBold"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
