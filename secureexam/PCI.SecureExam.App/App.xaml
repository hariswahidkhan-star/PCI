<Application x:Class="PCI.SecureExam.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Views/MainWindow.xaml">
  <Application.Resources>
    <ResourceDictionary>
      <!-- PCI brand tokens (match the web portal) -->
      <SolidColorBrush x:Key="Ink"       Color="#0F172A"/>
      <SolidColorBrush x:Key="Brand"     Color="#1D4ED8"/>
      <SolidColorBrush x:Key="BrandDeep" Color="#1E3A8A"/>
      <SolidColorBrush x:Key="Paper"     Color="#FFFFFF"/>
      <SolidColorBrush x:Key="Bg"        Color="#0B1322"/>
      <SolidColorBrush x:Key="Line"      Color="#E7EBF1"/>
      <SolidColorBrush x:Key="Muted"     Color="#64748B"/>
      <SolidColorBrush x:Key="Ok"        Color="#15803D"/>
      <SolidColorBrush x:Key="Warn"      Color="#92580A"/>
      <SolidColorBrush x:Key="Err"       Color="#B42318"/>

      <Style x:Key="Btn" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Brand}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Padding" Value="20,12"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border Background="{TemplateBinding Background}" CornerRadius="11" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
