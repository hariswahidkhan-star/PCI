
# Local translation/working scratch (not part of the app)
scratchpad/
node_modules/
backend/pci.db.migrate.lock

# Python bytecode (regenerated on import; never useful in VCS)
__pycache__/
*.py[cod]

# Content-run audit output — regenerated by the scripts beside them, not source. The inputs
# (url_map.json, valid_urls.json) stay tracked; these are derived and churn on every run.
docs/marketing/content/_tools/reports/
docs/marketing/content/_tools/link_audit.json
docs/marketing/content/_tools/quality_check.json
docs/marketing/content/_tools/note_audit.json
docs/marketing/content/_tools/anchor_audit.json
docs/marketing/content/_tools/frontmatter_audit.json
docs/marketing/content/_tools/claims_check.json

# Consolidated content deliverables — build artifacts, 5.6 MB, regenerated by
# docs/marketing/content/_tools/build_bundle.py from the tracked source files.
docs/marketing/PCI-content-run-all-347-pieces.md
docs/marketing/PCI-content-run-source.zip
docs/marketing/PCI-content-run.html
docs/marketing/PCI-publish-ready-pages.zip
docs/marketing/PCI-content-posting-pack.xlsx
docs/marketing/PCI-content-copy-pack.docx

# Generated publish-ready pages and sitemaps — rebuilt by
# docs/marketing/content/_tools/build_pages.py. The README beside them is hand-written
# and stays tracked, so the directory is filtered by extension rather than wholesale.
docs/marketing/pages/*.html
docs/marketing/pages/*.xml
