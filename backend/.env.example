# ── PCI platform — copy to .env and adjust. Everything is OPTIONAL for a first local boot. ──

# Port the whole platform serves on (website /, student/admin React apps, exam UI)
PORT=8080

# ── Database ──
# Production (Render) REQUIRES MySQL/MariaDB — see render.yaml and backend/MYSQL.md.
# SQLite is for local development and CI smoke only; Production refuses SQLite unless
# PCIWORLD_ALLOW_SQLITE (+ absolute DATABASE_FILE) or ALLOW_INSECURE_PRODUCTION is set.
#
# Local SQLite (default when DB_PROVIDER is unset):
# DB_PROVIDER=sqlite
# DATABASE_FILE=./pci.db
#
# Local / staging MySQL (recommended before shipping money or multi-instance work):
# DB_PROVIDER=mysql
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_DATABASE=pci
# MYSQL_USER=pci
# MYSQL_PASSWORD=pcipass
# MYSQL_SSL=false

DATABASE_FILE=./pci.db

# ── Admin access ──
# Bootstrap owner account (created on first run if no admins exist; must change password at first sign-in)
ADMIN_OWNER_EMAIL=owner@pci.local
ADMIN_OWNER_PASSWORD=changeme-owner
# Emergency shared token (acts as owner). Rotate/remove once real accounts exist.
ADMIN_TOKEN=change-this-long-random-string

# ── Payments (optional — without a key, checkout endpoints answer 503 and everything else works) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Student-panel domain (optional — RES-013 domain separation) ──
# Set to serve the logged-in student panel on its own domain (e.g. https://mypci.org) while the
# marketing site stays on APP_BASE_URL. One deployment serves both: /app and /student.html are
# redirected to this origin, marketing paths on this origin are redirected back, portal links in
# pages and emails become absolute to it, and the portal host is marked noindex.
# Leave BLANK for a single-domain deployment — nothing changes until this is set.
PORTAL_BASE_URL=
# Extra hostnames that should also serve the panel (comma-separated), e.g. www.mypci.org
PORTAL_HOSTS=

# ── Email ──
# Provider precedence: RESEND_API_KEY wins, else SMTP_HOST, else every email prints to the console
# and is recorded in the email log. GET /api/admin/system-check reports which one is actually active,
# the sender recipients will see, and sent/failed counts for the last 24h.
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SSL=true
SMTP_TIMEOUT_MS=20000
# REQUIRED once a provider is set. Without it the fallback sender is used, which the provider will
# reject unless that exact address is authorised — mail then "sends" and silently bounces.
# On Resend this must be a domain verified on your Resend account: the default onboarding sender
# delivers ONLY to the Resend account owner, so candidates receive nothing.
MAIL_FROM="Project Controls Institute <no-reply@yourdomain.org>"
# Optional: where replies go. Without it, replies go to the no-reply sender and are lost.
MAIL_REPLY_TO=

# ── CORS (only needed if a panel is hosted on a DIFFERENT origin than this backend) ──
ALLOWED_ORIGIN=*
