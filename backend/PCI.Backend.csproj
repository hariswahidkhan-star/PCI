<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>PCI.Backend</AssemblyName>
    <RootNamespace>PCI.Backend</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.7" />
    <!-- SQ-5: direct pins that override known-vulnerable TRANSITIVE versions with patched ones.
         Microsoft.Data.Sqlite 8.0.7 pulls SQLitePCLRaw.bundle_e_sqlite3 2.1.6 (GHSA-2m69-gcr7-jv3q,
         a vulnerable bundled SQLite); Stripe.net 45.14.0 pulls Newtonsoft.Json 12.0.3
         (GHSA-5crp-9r3c-p9vr, deep-recursion DoS). Pinning the fixed versions directly is the
         supported NuGet mechanism to lift a transitive dependency. Re-check the vulnerable-package
         report (the CI static-quality job) when bumping the parent packages. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.11" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="MySqlConnector" Version="2.3.7" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="Stripe.net" Version="45.14.0" />
    <PackageReference Include="AWSSDK.S3" Version="3.7.410" />
    <!-- Pure-managed QR generation (no native/System.Drawing deps): we read QRCodeData.ModuleMatrix
         and draw the modules directly into our self-contained PDF, so there is nothing to install on
         the host and the certificate engine works identically on any OS. -->
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <!-- PDFsharp: pure-managed PDF read/modify (no native libs) — used ONLY to stamp per-recipient
         watermarks onto admin-uploaded PDF documents. Certificates keep the hand-written CertPdf. -->
    <PackageReference Include="PDFsharp" Version="6.1.1" />
  </ItemGroup>
  <ItemGroup>
    <!-- reuse the SAME schema + email templates + static site as the Node app -->
    <!-- wwwroot is auto-included as Content by Microsoft.NET.Sdk.Web; Update (not Include)
         avoids NETSDK1022 duplicate items while keeping the copy-to-output behaviour -->
    <Content Update="wwwroot/**/*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="schema.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Include="schema.mysql.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Include="i18n_seed.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('i18n_seed.json')" />
    <None Include="certuvo_seed.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('certuvo_seed.json')" />
    <None Include="blog_seed_articles.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('blog_seed_articles.json')" />
    <None Include="news_seed_articles.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('news_seed_articles.json')" />
    <None Include="demo_exam_seed.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('demo_exam_seed.json')" />
    <None Include="emails/**/*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="books/**/*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
